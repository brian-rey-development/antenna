<beforebreak>\b\p{Lu}\.\p{Lu}\.[\s\u00A0]</beforebreak>
<afterbreak></afterbreak>
</rule>
<rule break="no">
<beforebreak>[^\.][\s\u00A0][A-Z]\.[\s\u00A0]</beforebreak>
<afterbreak></afterbreak>
</rule>
<rule break="no">
<beforebreak>\b(:?Blvd|Ave|Mts?)\.[\s\u00A0]</beforebreak>
<afterbreak>\p{Ll}+</afterbreak>
</rule>
<rule break="no">
<beforebreak>\b(?:Kan|Ill|M[ai]ss)\.[\s\u00A0]</beforebreak>
<afterbreak>\p{Ll}+</afterbreak>
</rule>
<rule break="no">
<beforebreak>\(\p{Ll}+\.[\s\u00A0]</beforebreak>
<afterbreak></afterbreak>
</rule>
<rule break="no">
<beforebreak>i\.e\.[\s\u00A0]</beforebreak>
<afterbreak></afterbreak>
</rule>
<rule break="yes">
<beforebreak>[\.!?…][\u00BB\u2019\u201D\u203A"'\p{Pe}\u0002¹²³]*[\s\u00A0]</beforebreak>
<afterbreak></afterbreak>
</rule>
<rule break="yes">
<beforebreak>[\.!?…]['"\u00BB\u2019\u201D\u203A\p{Pe}\u0002]*</beforebreak>
<afterbreak>\p{Lu}[^\p{Lu}]</afterbreak>
</rule>
<rule break="yes">
<beforebreak>[\s\u00A0]\p{L}[\.!?…][\s\u00A0]</beforebreak>
<afterbreak>\p{Lu}\p{Ll}</afterbreak>
</rule>
</languagerule>
<languagerule languagerulename="Default">
<rule break="yes">
<beforebreak>\p{L}[\.!?…]\u00A0+\s+</beforebreak>
<afterbreak>\p{Lu}\p{Ll}</afterbreak>
</rule>
<rule break="yes">
<beforebreak>\p{L}[\.!?…]\s+\u00A0+</beforebreak>
<afterbreak>\p{Lu}\p{Ll}</afterbreak>
</rule>
<rule break="yes">
<beforebreak>\u2029</beforebreak>
<afterbreak></afterbreak>
</rule>
<!--for smooth interoperability with Anaphraseus translation plugin for OpenOffice.org-->
<rule break="yes">
<beforebreak></beforebreak>
<afterbreak>&lt;0\}</afterbreak>
</rule>
<!--Anaphraseus segment start marker-->
<rule break="yes">
<beforebreak>\{0></beforebreak>
<afterbreak></afterbreak>
</rule>
<!--support srt files-->
<rule break="yes">
<beforebreak>\d{2}:\d{2}:\d{2},\d{3}\r?\n</beforebreak>
<afterbreak></afterbreak>
</rule>
</languagerule>
<languagerule languagerulename="Spanish">
<!-- 1. Punto primero-->
<rule break="no">
