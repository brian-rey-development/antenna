<afterbreak>\p{Lu}{2}</afterbreak>
</rule>
<rule break="no">
<beforebreak>EE\.[\s\u00A0]?UU\.[\s\u00A0]?</beforebreak>
<afterbreak>\p{Ll}</afterbreak>
</rule>
<!-- max min etc -->
<rule break="no">
<beforebreak>\b([Ee]tc|m[aá]x|m[ií]n|aprox|long|\d+o)\.[\p{Pe}\p{Pf}\p{Pd}"']*[\s\u00A0]</beforebreak>
<afterbreak>\p{Ll}</afterbreak>
</rule>
